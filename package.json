{
  "name": "sergeigolos.github.io",
  "description": "Sergei Golos — personal timeline/resume site (Qwik + JSON Resume)",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "trustedDependencies": [
    "sharp"
  ],
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "build.resume": "node scripts/generate-resume-pdf.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.3",
    "@builder.io/qwik-city": "^1.20.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@qwik.dev/partytown": "^1.0.3",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.14.0",
    "eslint-plugin-qwik": "^1.20.3",
    "jsonresume-theme-relaxed": "^0.2.1",
    "postcss": "^8.5.14",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "6.0.3",
    "undici": "^8.12.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@qwikest/icons": "^0.0.13"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "minimatch": "^11.0.4"
  }
}
